diff --git a/src/include/common/rptg_budget_model.h b/src/include/common/rptg_budget_model.h
new file mode 100644
index 0000000..9e212f0
--- /dev/null
+++ b/src/include/common/rptg_budget_model.h
@@ -0,0 +1,225 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include "common/rptg_transfer_info.h"
+
+namespace lbug {
+namespace common {
+
+// The decision logic of RPT-G's transfer budget, independent of where the sizes come from:
+//  - at run time the controller feeds exact mask cardinalities (final decisions);
+//  - at plan time the optimizer feeds zone-map selectivity estimates (pre-screen: if no transfer
+//    would be admitted, no side pipeline is emitted at all, so cheap queries pay nothing).
+struct RPTGBudgetModel {
+    std::vector<RPTGTransferInfo> infos;
+    std::vector<RPTGPlanNode> planNodes;
+    std::vector<RPTGVertexInfo> vertices;
+    std::vector<RPTGEdgeInfo> edges;
+    // sideAvgDeg[slot(e, v, other)]: average degree, along edge e, of the *current candidate set* of
+    // endpoint v. Table averages by default; the run-time controller overwrites them with exact
+    // degree sums / set sizes, which is what makes hub predicates come out right: the cost of a
+    // transfer is sum deg(B_x), and a random neighbour lies in B_x with probability sum deg(B_x)/|E|.
+    std::vector<double> sideAvgDeg;
+    double beta = 1.0;
+    double pipelineCost = 0;
+    // Wall-clock cost of one adjacency entry processed by a transfer pipeline, in main-plan tuple
+    // units (transfers from small source sets barely parallelize; masks are built by random inserts).
+    double transferUnitCost = 0.5;
+    // Measured in Kuzu: a transfer pipeline costs ~0.27 ms * |B_x|^0.43 almost regardless of the number
+    // of adjacency entries (per-source random CSR lookups, scattered vectors), i.e. srcCoef * |B_x|^srcExp
+    // in tuple units of ~25 ns. A self-mask pipeline costs ~1.1 ms.
+    double srcCoef = 10800, srcExp = 0.43;
+    double selfMaskCost = 44000;
+    // Main-plan scans apply a mask only if it keeps at most this fraction of the table.
+    double maskFraction = 1.0;
+    // Predicate-only size of every vertex (what a main-plan scan produces when its mask is not
+    // enabled); exact after the self-mask at run time, a zone-map estimate at plan time.
+    std::vector<double> baseSizes;
+
+    double transferCost(const RPTGTransferInfo& t, const std::vector<double>& sizes) const {
+        return pipelineCost + srcCoef * std::pow(std::max(sizes[t.x], 1.0), srcExp) +
+               transferUnitCost * sizes[t.x] * degOf(t.edgeIdx, t.x, t.y);
+    }
+    // Rows read by a scan cost this fraction of a tuple flowing through an operator.
+    static constexpr double SCAN_ROW_WEIGHT = 0.15;
+
+    struct Decision {
+        bool run = false;
+        double cost = 0, gain = 0;
+    };
+
+    // factor slot of (edge, target vertex): factors[slot] = product of the reductions the target
+    // received over that edge (information does not compound over a round trip on the same edge)
+    static size_t slot(uint32_t edgeIdx, uint32_t target, uint32_t other) {
+        return 2 * static_cast<size_t>(edgeIdx) + (target < other ? 0 : 1);
+    }
+
+    void initSideAvgDeg() {
+        sideAvgDeg.assign(2 * edges.size(), 1.0);
+        for (auto e = 0u; e < edges.size(); ++e) {
+            sideAvgDeg[slot(e, edges[e].a, edges[e].b)] = edges[e].avgDegA;
+            sideAvgDeg[slot(e, edges[e].b, edges[e].a)] = edges[e].avgDegB;
+        }
+    }
+    double degOf(uint32_t edgeIdx, uint32_t v, uint32_t other) const {
+        return sideAvgDeg[slot(edgeIdx, v, other)];
+    }
+
+    // Work of the main plan under factorized execution (Kuzu does not enumerate the cross product of
+    // independent extends): every subtree carries, per pattern vertex, the number of flat tuples of
+    // that vertex's group. SCAN(v) -> |B_v| (+ rows read); EXTEND(b -> o) -> cnt[o] = cnt[b] * deg;
+    // HASH_JOIN on key k scales the probe side by |build_k| / |V_k| and brings in the build side's
+    // vertices. Work = sum of everything produced. masked[v]: scans of v read only |B_v| rows.
+    double planWork(const std::vector<double>& sizes, const std::vector<bool>& masked) const {
+        auto numVertices = vertices.size();
+        std::vector<std::vector<double>> cnt(planNodes.size());
+        double work = 0;
+        for (auto i = 0u; i < planNodes.size(); ++i) {
+            auto& node = planNodes[i];
+            auto& c = cnt[i];
+            if (node.left >= 0) {
+                c = cnt[node.left];
+            } else {
+                c.assign(numVertices, -1.0);
+            }
+            switch (node.type) {
+            case RPTGPlanNodeType::SCAN: {
+                auto v = node.vertex;
+                double numNodes = vertices[v].numNodes;
+                // the mask takes effect on a main-plan scan only if it is selective enough
+                bool applied = masked[v] && sizes[v] <= maskFraction * numNodes;
+                double produced = applied || baseSizes.empty() ? sizes[v] : baseSizes[v];
+                c[v] = produced;
+                work += produced + SCAN_ROW_WEIGHT * (applied ? sizes[v] : numNodes);
+            } break;
+            case RPTGPlanNodeType::EXTEND: {
+                double from = -1.0;
+                if (node.edgeIdx >= 0 && c[node.vertex] >= 0) {
+                    from = c[node.vertex];
+                } else {
+                    for (auto x : c) {
+                        from = std::max(from, x);
+                    }
+                }
+                double produced = std::max(from, 0.0) *
+                                  (node.edgeIdx >= 0 ? degOf(static_cast<uint32_t>(node.edgeIdx),
+                                                           node.vertex, node.otherVertex) :
+                                                       node.avgDeg);
+                if (node.edgeIdx >= 0) {
+                    c[node.otherVertex] = produced;
+                }
+                work += produced;
+            } break;
+            case RPTGPlanNodeType::HASH_JOIN: {
+                if (node.right < 0) {
+                    break;
+                }
+                auto& r = cnt[node.right];
+                auto k = node.vertex;
+                if (node.numKeys > 0 && c[k] >= 0 && r[k] >= 0) {
+                    double probe = c[k], build = r[k];
+                    double keepProbe = std::min(1.0, build / node.numKeys);
+                    double keepBuild = std::min(1.0, probe / node.numKeys);
+                    for (auto v = 0u; v < numVertices; ++v) {
+                        if (c[v] >= 0) {
+                            c[v] *= keepProbe;
+                        } else if (r[v] >= 0) {
+                            c[v] = r[v] * keepBuild;
+                        }
+                    }
+                    work += probe;
+                } else {
+                    for (auto v = 0u; v < numVertices; ++v) {
+                        if (c[v] < 0) {
+                            c[v] = r[v];
+                        }
+                    }
+                }
+            } break;
+            default:
+                break;
+            }
+        }
+        return work;
+    }
+
+    double survival(const RPTGTransferInfo& t, const std::vector<double>& sizes,
+        const std::vector<double>& factors) const {
+        // undo the reduction x received from y over this very edge
+        double src = sizes[t.x] / std::max(factors[slot(t.edgeIdx, t.x, t.y)], 1e-12);
+        // share of the edge endpoints on the x side that belong to B_x
+        double rho = std::min(1.0,
+            src * degOf(t.edgeIdx, t.x, t.y) / std::max(edges[t.edgeIdx].numRels, 1.0));
+        return 1.0 - std::pow(1.0 - rho, degOf(t.edgeIdx, t.y, t.x));
+    }
+
+    void apply(const RPTGTransferInfo& t, std::vector<double>& sizes, std::vector<double>& factors,
+        std::vector<bool>& known) const {
+        double surv = survival(t, sizes, factors);
+        sizes[t.y] *= surv;
+        factors[slot(t.edgeIdx, t.y, t.x)] *= surv;
+        known[t.y] = true;
+    }
+
+    // Simulates transfers [from, end); returns the cost of the simulated ones other than `first`.
+    double simulate(uint32_t from, uint32_t first, std::vector<double>& sizes,
+        std::vector<double>& factors, std::vector<bool>& known) const {
+        double laterCost = 0;
+        for (auto j = from; j < infos.size(); ++j) {
+            auto& t = infos[j];
+            if (t.selfMask || !known[t.x]) {
+                continue; // a source nobody has informed transfers nothing
+            }
+            if (j != first) {
+                laterCost += transferCost(t, sizes);
+            }
+            apply(t, sizes, factors, known);
+        }
+        return laterCost;
+    }
+
+    // gain = [plan work + cost of later transfers] without T_idx minus the same with T_idx
+    Decision decide(uint32_t idx, const std::vector<double>& sizes, const std::vector<bool>& known,
+        const std::vector<double>& factors) const {
+        auto& info = infos[idx];
+        Decision d;
+        d.cost = transferCost(info, sizes);
+        auto sizesWith = sizes, sizesWithout = sizes;
+        auto factorsWith = factors, factorsWithout = factors;
+        auto knownWith = known, knownWithout = known;
+        double laterWith = simulate(idx, idx, sizesWith, factorsWith, knownWith);
+        double laterWithout = simulate(idx + 1, idx, sizesWithout, factorsWithout, knownWithout);
+        d.gain = (planWork(sizesWithout, knownWithout) + laterWithout) -
+                 (planWork(sizesWith, knownWith) + laterWith);
+        d.run = beta < 0 || d.cost <= beta * d.gain;
+        return d;
+    }
+
+    // Plan-time pre-screen: walks the sequence with estimated sizes and returns, per transfer, the
+    // decision the budget would take (applying the estimated effect of every admitted one). `slack` > 1
+    // makes it lenient; the run-time decision with exact sizes is the one that counts.
+    std::vector<Decision> prescreen(std::vector<double> sizes, std::vector<bool> known,
+        uint32_t numEdges, double slack) const {
+        std::vector<double> factors(2 * static_cast<size_t>(numEdges), 1.0);
+        std::vector<Decision> decisions(infos.size());
+        for (auto i = 0u; i < infos.size(); ++i) {
+            auto& t = infos[i];
+            if (t.selfMask || !known[t.x]) {
+                continue;
+            }
+            auto d = decide(i, sizes, known, factors);
+            d.run = beta < 0 || d.cost <= slack * beta * d.gain;
+            decisions[i] = d;
+            if (d.run) {
+                apply(t, sizes, factors, known);
+            }
+        }
+        return decisions;
+    }
+};
+
+} // namespace common
+} // namespace lbug
diff --git a/src/include/common/rptg_transfer_info.h b/src/include/common/rptg_transfer_info.h
new file mode 100644
index 0000000..3210641
--- /dev/null
+++ b/src/include/common/rptg_transfer_info.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace lbug {
+namespace common {
+
+// Static description of one RPT-G sub-plan, produced by the optimizer and consumed by the run-time
+// controller that decides, when a transfer is about to start, whether its exact cost is justified.
+struct RPTGTransferInfo {
+    // A self-mask pipeline B_x <- sigma_x(V_x): makes |B_x| an exact mask cardinality.
+    bool selfMask = false;
+    uint32_t x = 0, y = 0;
+    uint32_t edgeIdx = 0;
+    // Average number of pattern-edge neighbours of an x-vertex on the y side, and vice versa.
+    double avgDegXtoY = 0, avgDegYtoX = 0;
+};
+
+// The main plan, reduced to what determines its work: scans of pattern vertices, extends and hash
+// joins. Stored in post-order (children before parents). Evaluated at run time with the exact
+// candidate-set sizes, because the host estimates (10% per range predicate in Kuzu) are useless.
+enum class RPTGPlanNodeType : uint8_t { SCAN = 0, EXTEND = 1, HASH_JOIN = 2, PASS = 3, STOP = 4 };
+struct RPTGPlanNode {
+    RPTGPlanNodeType type = RPTGPlanNodeType::PASS;
+    int32_t left = -1, right = -1;
+    uint32_t vertex = 0;  // SCAN: scanned vertex; EXTEND: bound vertex
+    double avgDeg = 1;    // EXTEND: table-average neighbours per bound vertex
+    int32_t edgeIdx = -1; // EXTEND: pattern edge (-1 if unknown)
+    uint32_t otherVertex = 0; // EXTEND: neighbour vertex
+    double numKeys = 0;   // HASH_JOIN: size of the key vertex's table (0 if unknown)
+};
+
+// One pattern edge a -[rel]-> b.
+struct RPTGEdgeInfo {
+    uint32_t a = 0, b = 0;
+    double numRels = 0;
+    double avgDegA = 0, avgDegB = 0; // table averages: rels per a-vertex / per b-vertex
+};
+
+struct RPTGVertexInfo {
+    double numNodes = 0;
+    bool hasPredicate = false;
+};
+
+} // namespace common
+} // namespace lbug
