+// RPT-G: the chunk scan resets the selection vector, so the rows of a surviving vector are all
+// returned. Intersect the scanned positions with the mask again to make the candidate set exact.
+static void applySemiMaskRowFilter(const TableScanState& state, row_idx_t numRowsScanned,
+    SelectionVector& selVector) {
+    const auto startNodeOffset = state.nodeGroupScanState->nextRowToScan +
+                                 StorageUtils::getStartOffsetOfNodeGroup(state.nodeGroupIdx);
+    const auto& arr = state.semiMask->range(startNodeOffset, startNodeOffset + numRowsScanned);
+    const auto selSize = selVector.getSelSize();
+    std::vector<sel_t> kept;
+    kept.reserve(std::min<uint64_t>(selSize, arr.size()));
+    size_t i = 0, j = 0;
+    while (i < selSize && j < arr.size()) {
+        const auto pos = selVector[i];
+        const auto masked = arr[j] - startNodeOffset;
+        if (pos < masked) {
+            ++i;
+        } else if (pos > masked) {
+            ++j;
+        } else {
+            kept.push_back(pos);
+            ++i;
+            ++j;
+        }
+    }
+    auto buffer = selVector.getMutableBuffer();
+    for (size_t k = 0; k < kept.size(); ++k) {
+        buffer[k] = kept[k];
+    }
+    selVector.setToFiltered(kept.size());
+}
