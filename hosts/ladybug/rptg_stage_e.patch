diff --git a/src/include/processor/operator/rptg_transfer_sink.h b/src/include/processor/operator/rptg_transfer_sink.h
new file mode 100644
index 0000000..4bc35e3
--- /dev/null
+++ b/src/include/processor/operator/rptg_transfer_sink.h
@@ -0,0 +1,97 @@
+#pragma once
+
+#include <mutex>
+
+#include "common/mask.h"
+#include "common/rptg_budget_model.h"
+#include "processor/operator/semi_masker.h"
+#include "processor/operator/sink.h"
+
+namespace lbug {
+namespace processor {
+
+// Run-time side of RPT-G's transfer budget. Transfers run one after the other before the main
+// plan, so when transfer i is about to start every candidate set written so far has an exact size
+// (a mask cardinality); the controller feeds those to the budget model. A rejected transfer never
+// writes its target masks.
+class RPTGController {
+public:
+    RPTGController(common::RPTGBudgetModel model, uint32_t numEdges)
+        : model{std::move(model)}, maskers(this->model.infos.size(), nullptr),
+          vertexMask(this->model.vertices.size(), nullptr), decision(this->model.infos.size(), -1),
+          sizeBefore(this->model.infos.size(), 0), startedAtMs(this->model.infos.size(), 0),
+          edgeFactor(2 * static_cast<size_t>(numEdges), 1.0),
+          edgeDegrees(2 * static_cast<size_t>(numEdges), nullptr),
+          maskVersion(this->model.vertices.size(), 0),
+          degVersion(2 * static_cast<size_t>(numEdges), UINT64_MAX) {}
+
+    bool shouldRun(uint32_t idx);
+    void finished(uint32_t idx);
+
+    common::RPTGBudgetModel model;
+    std::vector<SemiMaskerSharedState*> maskers;
+    std::vector<common::SemiMask*> vertexMask; // one mask per pattern vertex that sees every write
+    // per (edge, side) degree arrays, RPTGBudgetModel::slot order
+
+private:
+    // Exact once a mask was written; otherwise the whole table, or the host's 10% default for a
+    // predicate vertex whose self-mask did not run (`optimistic` keeps the table size).
+    double sizeOf(uint32_t v, bool optimistic = false) const {
+        auto mask = vertexMask[v];
+        if (mask != nullptr && mask->isWritten()) {
+            return static_cast<double>(mask->getNumMaskedNodes());
+        }
+        auto& vertex = model.vertices[v];
+        return vertex.hasPredicate && !optimistic ? 0.1 * vertex.numNodes : vertex.numNodes;
+    }
+    bool informative(uint32_t v) const {
+        return vertexMask[v] != nullptr && vertexMask[v]->isWritten();
+    }
+
+    std::mutex mtx;
+    std::vector<int8_t> decision; // -1 undecided, 0 skip, 1 run
+    std::vector<double> sizeBefore;
+    std::vector<double> startedAtMs; // wall clock when the transfer was admitted (debug)
+    std::vector<double> edgeFactor; // realized reductions per (edge, target), see RPTGBudgetModel::slot
+
+public:
+    std::vector<std::shared_ptr<const std::vector<uint32_t>>> edgeDegrees;
+
+private:
+    // Exact average degree of every written candidate set along its incident pattern edges.
+    void refreshDegrees();
+    std::vector<uint64_t> maskVersion; // bumped whenever a vertex's mask was written
+    std::vector<uint64_t> degVersion;  // mask version the cached average was computed for
+};
+
+class RPTGTransferSink final : public Sink {
+    static constexpr PhysicalOperatorType type_ = PhysicalOperatorType::DUMMY_SINK;
+
+public:
+    RPTGTransferSink(std::shared_ptr<RPTGController> controller, uint32_t idx,
+        std::unique_ptr<PhysicalOperator> child, uint32_t id)
+        : Sink{type_, std::move(child), id, OPPrintInfo::EmptyInfo()},
+          controller{std::move(controller)}, idx{idx} {}
+
+    std::unique_ptr<PhysicalOperator> copy() override {
+        auto result = std::make_unique<RPTGTransferSink>(controller, idx, children[0]->copy(), id);
+        result->setDescriptor(resultSetDescriptor->copy());
+        return result;
+    }
+
+protected:
+    void executeInternal(ExecutionContext* context) override {
+        if (!controller->shouldRun(idx)) {
+            return;
+        }
+        while (children[0]->getNextTuple(context)) {}
+    }
+    void finalizeInternal(ExecutionContext* /*context*/) override { controller->finished(idx); }
+
+private:
+    std::shared_ptr<RPTGController> controller;
+    uint32_t idx;
+};
+
+} // namespace processor
+} // namespace lbug
