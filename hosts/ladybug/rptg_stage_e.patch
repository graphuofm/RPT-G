+#include "processor/operator/rptg_transfer_sink.h"
+
+#include <cstdio>
+#include <chrono>
+#include <cstdlib>
+#include <utility>
+
+using namespace lbug::common;
+
+namespace lbug {
+namespace processor {
+
+static double nowMs() {
+    return std::chrono::duration<double, std::milli>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+void RPTGController::refreshDegrees() {
+    for (auto e = 0u; e < model.edges.size(); ++e) {
+        auto& edge = model.edges[e];
+        for (auto [v, other] : {std::pair{edge.a, edge.b}, std::pair{edge.b, edge.a}}) {
+            auto s = RPTGBudgetModel::slot(e, v, other);
+            if (!informative(v) || edgeDegrees[s] == nullptr || degVersion[s] == maskVersion[v]) {
+                continue;
+            }
+            auto size = vertexMask[v]->getNumMaskedNodes();
+            if (size > 0) {
+                model.sideAvgDeg[s] = static_cast<double>(vertexMask[v]->sumOver(*edgeDegrees[s])) /
+                                      static_cast<double>(size);
+            }
+            degVersion[s] = maskVersion[v];
+        }
+    }
+}
+
+bool RPTGController::shouldRun(uint32_t idx) {
+    std::lock_guard<std::mutex> lck{mtx};
+    if (decision[idx] >= 0) {
+        return decision[idx] == 1;
+    }
+    auto& info = model.infos[idx];
+    bool debug = std::getenv("RPTG_DEBUG") != nullptr;
+    bool run = true;
+    refreshDegrees();
+    std::vector<double> sizes(model.vertices.size());
+    std::vector<bool> known(model.vertices.size());
+    for (auto v = 0u; v < model.vertices.size(); ++v) {
+        sizes[v] = sizeOf(v, info.selfMask /* optimistic upper bound for self-masks */);
+        known[v] = informative(v);
+    }
+    if (info.selfMask) {
+        // A self-mask is a pipeline too: once the main plan's work, bounded from above with the sizes
+        // known so far, is below the fixed cost of one pipeline, nothing that follows can pay off.
+        if (model.beta >= 0) {
+            double upper = model.planWork(sizes, known);
+            run = model.beta * upper >= model.selfMaskCost;
+            if (debug) {
+                fprintf(stderr, "[rptg] T%u self-mask of vertex %u: plan work <= %.0f -> %s\n", idx,
+                    info.x, upper, run ? "RUN" : "SKIP");
+            }
+        }
+    } else {
+        if (!known[info.x]) {
+            run = false; // run-time source skip: nothing was written into x
+        } else if (model.beta >= 0) {
+            auto d = model.decide(idx, sizes, known, edgeFactor);
+            run = d.run;
+            if (debug) {
+                fprintf(stderr,
+                    "[rptg] T%u %u->%u |Bx|=%.0f (deg %.1f) |By|=%.0f (deg %.1f) cost=%.0f gain=%.0f (plan work now %.0f) -> %s\n",
+                    idx, info.x, info.y, sizes[info.x], model.degOf(info.edgeIdx, info.x, info.y),
+                    sizes[info.y], model.degOf(info.edgeIdx, info.y, info.x), d.cost, d.gain,
+                    model.planWork(sizes, known), run ? "RUN" : "SKIP");
+            }
+        }
+        sizeBefore[idx] = sizeOf(info.y);
+    }
+    decision[idx] = run ? 1 : 0;
+    startedAtMs[idx] = nowMs();
+    if (!run && maskers[idx] != nullptr) {
+        maskers[idx]->setSkipped();
+    }
+    return run;
+}
+
+void RPTGController::finished(uint32_t idx) {
+    std::lock_guard<std::mutex> lck{mtx};
+    auto& info = model.infos[idx];
+    if (decision[idx] == 1 && info.selfMask) {
+        model.baseSizes[info.x] = sizeOf(info.x); // exact predicate-only size
+    }
+    if (decision[idx] == 1) {
+        maskVersion[info.y]++;
+        if (std::getenv("RPTG_DEBUG") != nullptr) {
+            fprintf(stderr, "[rptg] T%u done in %.2f ms: |B%u| %.0f -> %.0f\n", idx,
+                nowMs() - startedAtMs[idx], info.y,
+                info.selfMask ? model.vertices[info.y].numNodes : sizeBefore[idx], sizeOf(info.y));
+        }
+    }
+    if (decision[idx] == 1 && !info.selfMask && sizeBefore[idx] > 0) {
+        edgeFactor[RPTGBudgetModel::slot(info.edgeIdx, info.y, info.x)] *=
+            sizeOf(info.y) / sizeBefore[idx];
+    }
+}
+
+} // namespace processor
+} // namespace lbug
