+
+RPTGDegreeCache::degrees_t RPTGDegreeCache::get(main::ClientContext* context,
+    table_id_t relTableID, RelDataDirection direction) {
+    static std::mutex mtx;
+    static std::map<std::tuple<const StorageManager*, table_id_t, RelDataDirection>, degrees_t> cache;
+    auto storageManager = storage::StorageManager::Get(*context);
+    auto key = std::make_tuple(static_cast<const StorageManager*>(storageManager), relTableID, direction);
+    std::lock_guard<std::mutex> lck{mtx};
+    if (cache.contains(key)) {
+        return cache.at(key);
+    }
+    degrees_t result = nullptr;
+    try {
+        auto relTable = storageManager->getTable(relTableID)->ptrCast<RelTable>();
+        auto data = relTable->getDirectedTableData(direction);
+        auto transaction = transaction::Transaction::Get(*context);
+        auto numGroups = data->getNumNodeGroups();
+        auto degrees = std::make_shared<std::vector<uint32_t>>(
+            static_cast<size_t>(numGroups) * StorageConfig::NODE_GROUP_SIZE, 0u);
+        for (auto g = 0u; g < numGroups; ++g) {
+            auto nodeGroup = data->getNodeGroup(g);
+            if (nodeGroup == nullptr) {
+                continue;
+            }
+            auto persistent = static_cast<CSRNodeGroup*>(nodeGroup)->getPersistentChunkedGroup();
+            if (persistent == nullptr) {
+                continue;
+            }
+            auto& header = persistent->cast<ChunkedCSRNodeGroup>().getCSRHeader();
+            auto numNodes = header.length->getNumValues();
+            auto base = static_cast<size_t>(g) * StorageConfig::NODE_GROUP_SIZE;
+            if (header.length->getResidencyState() == ResidencyState::ON_DISK) {
+                InMemChunkedCSRHeader inMemory(*context->getDatabase()->getMemoryManager(),
+                    false /* compression */, StorageConfig::NODE_GROUP_SIZE);
+                ChunkState lengthState;
+                header.length->initializeScanState(lengthState, data->getCSRLengthColumn());
+                header.length->scanCommitted<ResidencyState::ON_DISK>(transaction, lengthState,
+                    *inMemory.length);
+                for (auto i = 0u; i < numNodes; ++i) {
+                    (*degrees)[base + i] = static_cast<uint32_t>(inMemory.getCSRLength(i));
+                }
+            } else {
+                for (auto i = 0u; i < numNodes; ++i) {
+                    (*degrees)[base + i] = static_cast<uint32_t>(header.getCSRLength(i));
+                }
+            }
+        }
+        result = degrees;
+    } catch (std::exception&) {
+        result = nullptr; // statistics are optional: fall back to table averages
+    }
+    cache.insert({key, result});
+    return result;
+}
+
+} // namespace storage
+} // namespace lbug
