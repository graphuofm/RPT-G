diff --git a/src/optimizer/rptg_transfer_optimizer.cpp b/src/optimizer/rptg_transfer_optimizer.cpp
new file mode 100644
index 0000000..75ec408
--- /dev/null
+++ b/src/optimizer/rptg_transfer_optimizer.cpp
@@ -0,0 +1,809 @@
+#include "optimizer/rptg_transfer_optimizer.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <optional>
+#include <unordered_map>
+
+#include "binder/expression/literal_expression.h"
+#include "binder/expression/node_expression.h"
+#include "binder/expression/property_expression.h"
+#include "binder/expression/rel_expression.h"
+#include "catalog/catalog_entry/table_catalog_entry.h"
+#include "common/rptg_budget_model.h"
+#include "main/client_context.h"
+#include "main/database.h"
+#include "optimizer/cardinality_updater.h"
+#include "optimizer/factorization_rewriter.h"
+#include "planner/operator/extend/logical_extend.h"
+#include "planner/operator/logical_dummy_sink.h"
+#include "planner/operator/logical_filter.h"
+#include "planner/operator/logical_hash_join.h"
+#include "planner/operator/scan/logical_scan_node_table.h"
+#include "planner/operator/sip/logical_semi_masker.h"
+#include "storage/rptg_degree_cache.h"
+#include "storage/storage_manager.h"
+#include "storage/table/chunked_node_group.h"
+#include "storage/table/node_table.h"
+#include "storage/table/table.h"
+#include "transaction/transaction.h"
+
+using namespace lbug::binder;
+using namespace lbug::common;
+using namespace lbug::planner;
+using namespace lbug::storage;
+
+namespace lbug {
+namespace optimizer {
+
+namespace {
+
+struct PatternVertex {
+    std::shared_ptr<NodeExpression> node;
+    // Topmost operator of the [FILTER ... FILTER -> SCAN_NODE_TABLE] chain that evaluates sigma_x
+    // in the main plan; nullptr if the vertex carries no predicate.
+    LogicalOperator* predicateChain = nullptr;
+    // SCAN_NODE_TABLE operators that consume the candidate set of this vertex.
+    std::vector<LogicalOperator*> mainScans;
+    std::vector<std::pair<uint32_t, LogicalOperator*>> transferScans; // (transfer idx, scan)
+    uint32_t sources = 0;
+    cardinality_t estimatedCardinality = 0;
+    double workPerTuple = 0; // host-estimated main-plan work per tuple leaving the scans of this vertex
+};
+
+struct PatternEdge {
+    uint32_t a, b; // vertex indices; the rel goes from its src node to its dst node
+    std::shared_ptr<RelExpression> rel;
+};
+
+struct Transfer {
+    uint32_t x, y, edgeIdx;
+};
+
+struct Pattern {
+    std::vector<PatternVertex> vertices;
+    std::vector<PatternEdge> edges;
+    std::unordered_map<std::string, uint32_t> vertexIdx;
+    bool supported = true;
+
+    uint32_t getVertex(const std::shared_ptr<NodeExpression>& node) {
+        auto name = node->getUniqueName();
+        if (!vertexIdx.contains(name)) {
+            vertexIdx.insert({name, static_cast<uint32_t>(vertices.size())});
+            vertices.push_back(PatternVertex{node});
+        }
+        return vertexIdx.at(name);
+    }
+};
+
+bool isTransparent(LogicalOperatorType type) {
+    switch (type) {
+    case LogicalOperatorType::SCAN_NODE_TABLE:
+    case LogicalOperatorType::FILTER:
+    case LogicalOperatorType::EXTEND:
+    case LogicalOperatorType::HASH_JOIN:
+    case LogicalOperatorType::FLATTEN:
+    case LogicalOperatorType::PROJECTION:
+    case LogicalOperatorType::AGGREGATE:
+    case LogicalOperatorType::LIMIT:
+    case LogicalOperatorType::ORDER_BY:
+    case LogicalOperatorType::MULTIPLICITY_REDUCER:
+    case LogicalOperatorType::EXPLAIN:
+        return true;
+    default:
+        return false;
+    }
+}
+
+// Walks the main plan; parent is the operator directly above op.
+void collect(LogicalOperator* op, LogicalOperator* parent, LogicalOperator* topFilter,
+    Pattern& pattern, std::vector<LogicalOperator*>& path) {
+    if (!isTransparent(op->getOperatorType())) {
+        pattern.supported = false;
+        return;
+    }
+    switch (op->getOperatorType()) {
+    case LogicalOperatorType::HASH_JOIN: {
+        if (op->constCast<LogicalHashJoin>().getJoinType() != JoinType::INNER) {
+            pattern.supported = false;
+            return;
+        }
+    } break;
+    case LogicalOperatorType::EXTEND: {
+        auto& extend = op->constCast<LogicalExtend>();
+        auto rel = extend.getRel();
+        if (rel->isRecursive() || rel->getDirectionType() == RelDirectionType::BOTH) {
+            pattern.supported = false;
+            return;
+        }
+        auto a = pattern.getVertex(rel->getSrcNode());
+        auto b = pattern.getVertex(rel->getDstNode());
+        pattern.edges.push_back(PatternEdge{a, b, rel});
+    } break;
+    case LogicalOperatorType::SCAN_NODE_TABLE: {
+        auto& scan = op->constCast<LogicalScanNodeTable>();
+        if (scan.getScanType() != LogicalScanNodeTableType::SCAN) {
+            break;
+        }
+        auto name = scan.getNodeID()->getUniqueName();
+        for (auto& v : pattern.vertices) {
+            if (v.node->getInternalID()->getUniqueName() == name) {
+                v.mainScans.push_back(op);
+                if (topFilter != nullptr && v.predicateChain == nullptr) {
+                    v.predicateChain = topFilter;
+                    v.estimatedCardinality = topFilter->getCardinality();
+                }
+                // Work above this scan: tuples flowing through every operator between the scan's
+                // filter chain and the root, per tuple leaving the chain (host estimates).
+                auto chainTop = topFilter != nullptr ? topFilter : op;
+                double above = 0;
+                for (auto ancestor : path) {
+                    if (ancestor == chainTop) {
+                        break;
+                    }
+                    above += static_cast<double>(ancestor->getCardinality());
+                }
+                v.workPerTuple +=
+                    above / std::max<double>(1.0, static_cast<double>(chainTop->getCardinality()));
+            }
+        }
+    } break;
+    default:
+        break;
+    }
+    (void)parent;
+    for (auto i = 0u; i < op->getNumChildren(); ++i) {
+        auto child = op->getChild(i).get();
+        LogicalOperator* nextTopFilter = nullptr;
+        if (child->getOperatorType() == LogicalOperatorType::FILTER) {
+            // keep the topmost filter of a consecutive filter chain
+            nextTopFilter = op->getOperatorType() == LogicalOperatorType::FILTER && topFilter ?
+                                topFilter :
+                                child;
+        } else if (child->getOperatorType() == LogicalOperatorType::SCAN_NODE_TABLE &&
+                   op->getOperatorType() == LogicalOperatorType::FILTER) {
+            nextTopFilter = topFilter;
+        }
+        path.push_back(op);
+        collect(child, op, nextTopFilter, pattern, path);
+        path.pop_back();
+    }
+}
+
+bool isTree(const Pattern& pattern) {
+    auto n = pattern.vertices.size();
+    if (n < 2 || pattern.edges.size() != n - 1) {
+        return false;
+    }
+    std::vector<uint32_t> parent(n);
+    for (auto i = 0u; i < n; ++i) {
+        parent[i] = i;
+    }
+    std::function<uint32_t(uint32_t)> find = [&](uint32_t v) {
+        return parent[v] == v ? v : parent[v] = find(parent[v]);
+    };
+    for (auto& e : pattern.edges) {
+        auto ra = find(e.a), rb = find(e.b);
+        if (ra == rb) {
+            return false;
+        }
+        parent[ra] = rb;
+    }
+    return true;
+}
+
+// Algorithm 1': root = a predicate-less vertex if any (ties: first), children ordered by ascending
+// estimated candidate-set size; forward = post-order (child -> parent), backward = pre-order.
+std::vector<Transfer> buildSequence(const Pattern& pattern) {
+    auto n = static_cast<uint32_t>(pattern.vertices.size());
+    uint32_t root = 0;
+    for (auto v = 0u; v < n; ++v) {
+        if (pattern.vertices[v].predicateChain == nullptr) {
+            root = v;
+            break;
+        }
+    }
+    std::vector<std::vector<std::pair<uint32_t, uint32_t>>> adj(n); // (neighbour, edge idx)
+    for (auto i = 0u; i < pattern.edges.size(); ++i) {
+        adj[pattern.edges[i].a].emplace_back(pattern.edges[i].b, i);
+        adj[pattern.edges[i].b].emplace_back(pattern.edges[i].a, i);
+    }
+    std::vector<Transfer> forward, backward;
+    std::function<void(uint32_t, uint32_t)> visit = [&](uint32_t v, uint32_t parentVertex) {
+        auto children = adj[v];
+        std::stable_sort(children.begin(), children.end(), [&](auto& l, auto& r) {
+            return pattern.vertices[l.first].estimatedCardinality <
+                   pattern.vertices[r.first].estimatedCardinality;
+        });
+        for (auto& [c, e] : children) {
+            if (c == parentVertex) {
+                continue;
+            }
+            backward.push_back(Transfer{v, c, e});
+            visit(c, v);
+            forward.push_back(Transfer{c, v, e});
+        }
+    };
+    visit(root, UINT32_MAX);
+    // backward was emitted in pre-order already; forward in post-order.
+    std::vector<Transfer> sequence = forward;
+    sequence.insert(sequence.end(), backward.begin(), backward.end());
+    return sequence;
+}
+
+// Source skip (Lemma P5) simulated at plan time + consumption: a transfer x -> y is kept iff it
+// carries information y does not have yet and that information is consumed — by a scan of y in the
+// main plan, or by a later kept transfer that reads y.
+std::vector<bool> pruneUseless(const Pattern& pattern, const std::vector<Transfer>& sequence) {
+    std::vector<uint32_t> sources(pattern.vertices.size(), 0);
+    for (auto v = 0u; v < pattern.vertices.size(); ++v) {
+        sources[v] = pattern.vertices[v].predicateChain != nullptr ? (1u << v) : 0u;
+    }
+    std::vector<bool> effective(sequence.size(), false), useful(sequence.size(), false);
+    for (auto i = 0u; i < sequence.size(); ++i) {
+        effective[i] = (sources[sequence[i].x] & ~sources[sequence[i].y]) != 0;
+        if (effective[i]) {
+            sources[sequence[i].y] |= sources[sequence[i].x];
+        }
+    }
+    for (auto i = static_cast<int64_t>(sequence.size()) - 1; i >= 0; --i) {
+        if (!effective[i]) {
+            continue;
+        }
+        bool consumed = !pattern.vertices[sequence[i].y].mainScans.empty();
+        for (auto j = static_cast<uint64_t>(i) + 1; j < sequence.size() && !consumed; ++j) {
+            consumed = useful[j] && sequence[j].x == sequence[i].y;
+        }
+        useful[i] = consumed;
+    }
+    return useful;
+}
+
+// ---- plan-time selectivity estimates from zone maps ------------------------------------------
+// Kuzu estimates every range predicate at 10%. The column min/max kept for zone maps give a far
+// better (uniformity) estimate for free; it only drives the pre-screen, never a final decision.
+
+std::optional<double> literalAsDouble(const Expression& expr) {
+    if (expr.expressionType != ExpressionType::LITERAL) {
+        return std::nullopt;
+    }
+    auto value = expr.constCast<LiteralExpression>().getValue();
+    if (value.isNull()) {
+        return std::nullopt;
+    }
+    switch (value.getDataType().getLogicalTypeID()) {
+    case LogicalTypeID::DOUBLE:
+        return value.getValue<double>();
+    case LogicalTypeID::FLOAT:
+        return static_cast<double>(value.getValue<float>());
+    case LogicalTypeID::INT64:
+        return static_cast<double>(value.getValue<int64_t>());
+    case LogicalTypeID::INT32:
+        return static_cast<double>(value.getValue<int32_t>());
+    case LogicalTypeID::INT16:
+        return static_cast<double>(value.getValue<int16_t>());
+    case LogicalTypeID::INT8:
+        return static_cast<double>(value.getValue<int8_t>());
+    case LogicalTypeID::UINT64:
+        return static_cast<double>(value.getValue<uint64_t>());
+    case LogicalTypeID::UINT32:
+        return static_cast<double>(value.getValue<uint32_t>());
+    default:
+        return std::nullopt;
+    }
+}
+
+// Strips CAST(...) and similar single-argument wrappers around a property reference.
+const PropertyExpression* asProperty(const Expression& expr) {
+    auto current = &expr;
+    while (current->expressionType == ExpressionType::FUNCTION && current->getNumChildren() == 1) {
+        current = current->getChild(0).get();
+    }
+    return current->expressionType == ExpressionType::PROPERTY ?
+               &current->constCast<PropertyExpression>() :
+               nullptr;
+}
+
+struct ColumnRange {
+    double min = 0, max = 0;
+    bool integral = false;
+};
+
+std::optional<ColumnRange> columnRange(main::ClientContext* context, const NodeExpression& node,
+    const std::string& propertyName) {
+    auto entries = node.getEntries();
+    if (entries.size() != 1 || !entries[0]->containsProperty(propertyName)) {
+        return std::nullopt;
+    }
+    auto columnID = entries[0]->getColumnID(propertyName);
+    auto table = storage::StorageManager::Get(*context)->getTable(entries[0]->getTableID())->ptrCast<NodeTable>();
+    auto transaction = transaction::Transaction::Get(*context);
+    std::optional<ColumnRange> range;
+    for (auto g = 0u; g < table->getNumNodeGroups(); ++g) {
+        auto nodeGroup = table->getNodeGroup(g);
+        for (auto c = 0u; c < nodeGroup->getNumChunkedGroups(); ++c) {
+            auto& chunk = nodeGroup->getChunkedNodeGroup(c)->getColumnChunk(columnID);
+            auto merged = chunk.getMergedColumnChunkStats();
+            if (!merged.stats.min.has_value() || !merged.stats.max.has_value()) {
+                return std::nullopt;
+            }
+            double lo = 0, hi = 0;
+            bool integral = false;
+            switch (chunk.getDataType().getPhysicalType()) {
+            case PhysicalTypeID::DOUBLE:
+            case PhysicalTypeID::FLOAT:
+                lo = merged.stats.min->get<double>();
+                hi = merged.stats.max->get<double>();
+                break;
+            case PhysicalTypeID::INT64:
+            case PhysicalTypeID::INT32:
+            case PhysicalTypeID::INT16:
+            case PhysicalTypeID::INT8:
+                lo = static_cast<double>(merged.stats.min->get<int64_t>());
+                hi = static_cast<double>(merged.stats.max->get<int64_t>());
+                integral = true;
+                break;
+            case PhysicalTypeID::UINT64:
+            case PhysicalTypeID::UINT32:
+            case PhysicalTypeID::UINT16:
+            case PhysicalTypeID::UINT8:
+                lo = static_cast<double>(merged.stats.min->get<uint64_t>());
+                hi = static_cast<double>(merged.stats.max->get<uint64_t>());
+                integral = true;
+                break;
+            default:
+                return std::nullopt;
+            }
+            if (!range.has_value()) {
+                range = ColumnRange{lo, hi, integral};
+            } else {
+                range->min = std::min(range->min, lo);
+                range->max = std::max(range->max, hi);
+            }
+        }
+    }
+    return range;
+}
+
+constexpr double HOST_DEFAULT_SELECTIVITY = 0.1;
+
+double estimateSelectivity(main::ClientContext* context, const NodeExpression& node,
+    const Expression& predicate) {
+    switch (predicate.expressionType) {
+    case ExpressionType::AND: {
+        double sel = 1.0;
+        for (auto i = 0u; i < predicate.getNumChildren(); ++i) {
+            sel *= estimateSelectivity(context, node, *predicate.getChild(i));
+        }
+        return sel;
+    }
+    case ExpressionType::OR: {
+        double sel = 0.0;
+        for (auto i = 0u; i < predicate.getNumChildren(); ++i) {
+            sel += estimateSelectivity(context, node, *predicate.getChild(i));
+        }
+        return std::min(1.0, sel);
+    }
+    case ExpressionType::EQUALS:
+    case ExpressionType::LESS_THAN:
+    case ExpressionType::LESS_THAN_EQUALS:
+    case ExpressionType::GREATER_THAN:
+    case ExpressionType::GREATER_THAN_EQUALS: {
+        if (predicate.getNumChildren() != 2) {
+            return HOST_DEFAULT_SELECTIVITY;
+        }
+        auto property = asProperty(*predicate.getChild(0));
+        auto literal = literalAsDouble(*predicate.getChild(1));
+        bool flipped = false;
+        if (property == nullptr || !literal.has_value()) {
+            property = asProperty(*predicate.getChild(1));
+            literal = literalAsDouble(*predicate.getChild(0));
+            flipped = true;
+        }
+        if (property == nullptr || !literal.has_value()) {
+            return HOST_DEFAULT_SELECTIVITY;
+        }
+        auto range = columnRange(context, node, property->getPropertyName());
+        if (!range.has_value()) {
+            return HOST_DEFAULT_SELECTIVITY;
+        }
+        double width = range->max - range->min;
+        if (predicate.expressionType == ExpressionType::EQUALS) {
+            if (*literal < range->min || *literal > range->max) {
+                return 0.0;
+            }
+            return range->integral ? 1.0 / (width + 1.0) : 0.01;
+        }
+        if (width <= 0) {
+            return HOST_DEFAULT_SELECTIVITY;
+        }
+        double below = std::clamp((*literal - range->min) / width, 0.0, 1.0); // P(value < literal)
+        bool lessThan = predicate.expressionType == ExpressionType::LESS_THAN ||
+                        predicate.expressionType == ExpressionType::LESS_THAN_EQUALS;
+        return (lessThan != flipped) ? below : 1.0 - below;
+    }
+    default:
+        return HOST_DEFAULT_SELECTIVITY;
+    }
+}
+
+// Selectivity of the whole [FILTER ... FILTER -> SCAN] chain of a vertex.
+double estimateChainSelectivity(main::ClientContext* context, const NodeExpression& node,
+    LogicalOperator* chainTop) {
+    double sel = 1.0;
+    for (auto op = chainTop; op->getOperatorType() == LogicalOperatorType::FILTER;
+         op = op->getChild(0).get()) {
+        sel *= estimateSelectivity(context, node, *op->constCast<LogicalFilter>().getPredicate());
+    }
+    return sel;
+}
+
+LogicalOperator* findScan(LogicalOperator* op) {
+    while (op->getOperatorType() != LogicalOperatorType::SCAN_NODE_TABLE) {
+        op = op->getChild(0).get();
+    }
+    return op;
+}
+
+} // namespace
+
+void RPTGTransferOptimizer::rewrite(LogicalPlan* plan) {
+    Pattern pattern;
+    // Two passes: edges first so that scans can be matched to pattern vertices.
+    std::function<void(LogicalOperator*)> collectEdges = [&](LogicalOperator* op) {
+        if (op->getOperatorType() == LogicalOperatorType::EXTEND) {
+            auto rel = op->constCast<LogicalExtend>().getRel();
+            if (!rel->isRecursive()) {
+                pattern.getVertex(rel->getSrcNode());
+                pattern.getVertex(rel->getDstNode());
+            }
+        }
+        for (auto i = 0u; i < op->getNumChildren(); ++i) {
+            collectEdges(op->getChild(i).get());
+        }
+    };
+    collectEdges(plan->getLastOperator().get());
+    if (pattern.vertices.empty()) {
+        return;
+    }
+    // Earlier rewrites leave stale cardinalities; the benefit side of the budget reads them.
+    try {
+        CardinalityUpdater(cardinalityEstimator, transaction::Transaction::Get(*context)).rewrite(plan);
+    } catch (std::exception& e) {
+        // The estimator's per-node domain table may not cover a mid-optimization plan; fall back to
+        // the cardinalities the planner left on the operators.
+        if (std::getenv("RPTG_DEBUG") != nullptr) {
+            fprintf(stderr, "[rptg] cardinality update failed: %s\n", e.what());
+        }
+    }
+    std::vector<LogicalOperator*> path;
+    collect(plan->getLastOperator().get(), nullptr, nullptr, pattern, path);
+    if (!pattern.supported || !isTree(pattern) || pattern.vertices.size() > 30) {
+        return;
+    }
+    bool hasPredicate = false;
+    for (auto& v : pattern.vertices) {
+        hasPredicate |= v.predicateChain != nullptr;
+    }
+    if (!hasPredicate) {
+        return;
+    }
+    auto sequence = buildSequence(pattern);
+    auto useful = pruneUseless(pattern, sequence);
+    if (std::none_of(useful.begin(), useful.end(), [](bool b) { return b; })) {
+        return;
+    }
+
+    // Table statistics for the exact-cost side of the budget.
+    auto transaction = transaction::Transaction::Get(*context);
+    auto storageManager = storage::StorageManager::Get(*context);
+    auto numRows = [&](const table_id_vector_t& tableIDs) {
+        double rows = 0;
+        for (auto tableID : tableIDs) {
+            rows += static_cast<double>(storageManager->getTable(tableID)->getNumTotalRows(transaction));
+        }
+        return rows;
+    };
+
+    struct Planned {
+        bool selfMask;
+        uint32_t x, y, edgeIdx;
+    };
+    // Candidate sub-plans: self-masks of the predicate vertices, then the kept transfers in order.
+    std::vector<Planned> candidates;
+    for (auto v = 0u; v < pattern.vertices.size(); ++v) {
+        if (pattern.vertices[v].predicateChain != nullptr) {
+            candidates.push_back(Planned{true, v, v, 0});
+        }
+    }
+    for (auto i = 0u; i < sequence.size(); ++i) {
+        if (useful[i]) {
+            candidates.push_back(Planned{false, sequence[i].x, sequence[i].y, sequence[i].edgeIdx});
+        }
+    }
+    auto makeInfo = [&](const Planned& t) {
+        RPTGTransferInfo info;
+        info.selfMask = t.selfMask;
+        info.x = t.x;
+        info.y = t.y;
+        info.edgeIdx = t.edgeIdx;
+        if (!t.selfMask) {
+            auto& edge = pattern.edges[t.edgeIdx];
+            double numRels = numRows(edge.rel->getInnerRelTableIDs()); // storage-level rel table ids
+            info.avgDegXtoY =
+                numRels / std::max(numRows(pattern.vertices[t.x].node->getTableIDs()), 1.0);
+            info.avgDegYtoX =
+                numRels / std::max(numRows(pattern.vertices[t.y].node->getTableIDs()), 1.0);
+        }
+        return info;
+    };
+
+    // The main plan as a work model for the budget (post-order).
+    std::vector<RPTGPlanNode> planNodes;
+    auto vertexOf = [&](const std::string& internalIDName) -> int32_t {
+        for (auto v = 0u; v < pattern.vertices.size(); ++v) {
+            if (pattern.vertices[v].node->getInternalID()->getUniqueName() == internalIDName) {
+                return static_cast<int32_t>(v);
+            }
+        }
+        return -1;
+    };
+    std::function<int32_t(LogicalOperator*)> serialize = [&](LogicalOperator* op) -> int32_t {
+        RPTGPlanNode node;
+        switch (op->getOperatorType()) {
+        case LogicalOperatorType::SCAN_NODE_TABLE: {
+            auto v = vertexOf(op->constCast<LogicalScanNodeTable>().getNodeID()->getUniqueName());
+            if (v < 0) {
+                node.type = RPTGPlanNodeType::STOP;
+            } else {
+                node.type = RPTGPlanNodeType::SCAN;
+                node.vertex = static_cast<uint32_t>(v);
+            }
+        } break;
+        case LogicalOperatorType::EXTEND: {
+            auto& extend = op->constCast<LogicalExtend>();
+            node.type = RPTGPlanNodeType::EXTEND;
+            node.left = serialize(op->getChild(0).get());
+            node.avgDeg = numRows(extend.getRel()->getInnerRelTableIDs()) /
+                          std::max(numRows(extend.getBoundNode()->getTableIDs()), 1.0);
+            auto bound = vertexOf(extend.getBoundNode()->getInternalID()->getUniqueName());
+            auto nbr = vertexOf(extend.getNbrNode()->getInternalID()->getUniqueName());
+            for (auto e = 0u; e < pattern.edges.size() && bound >= 0 && nbr >= 0; ++e) {
+                if (pattern.edges[e].rel->getUniqueName() == extend.getRel()->getUniqueName()) {
+                    node.edgeIdx = static_cast<int32_t>(e);
+                    node.vertex = static_cast<uint32_t>(bound);
+                    node.otherVertex = static_cast<uint32_t>(nbr);
+                }
+            }
+        } break;
+        case LogicalOperatorType::HASH_JOIN: {
+            node.type = RPTGPlanNodeType::HASH_JOIN;
+            node.left = serialize(op->getChild(0).get());
+            node.right = serialize(op->getChild(1).get());
+            auto keys = op->constCast<LogicalHashJoin>().getJoinNodeIDs();
+            if (!keys.empty()) {
+                auto v = vertexOf(keys[0]->getUniqueName());
+                node.numKeys = v < 0 ? 0 : numRows(pattern.vertices[v].node->getTableIDs());
+                node.vertex = v < 0 ? 0 : static_cast<uint32_t>(v);
+            }
+        } break;
+        case LogicalOperatorType::AGGREGATE: {
+            node.type = RPTGPlanNodeType::STOP;
+            node.left = serialize(op->getChild(0).get());
+        } break;
+        default: {
+            node.type = RPTGPlanNodeType::PASS;
+            if (op->getNumChildren() > 0) {
+                node.left = serialize(op->getChild(0).get());
+            }
+        } break;
+        }
+        planNodes.push_back(node);
+        return static_cast<int32_t>(planNodes.size()) - 1;
+    };
+    serialize(plan->getLastOperator().get());
+    std::vector<RPTGVertexInfo> vertexInfos;
+    for (auto& v : pattern.vertices) {
+        vertexInfos.push_back(
+            RPTGVertexInfo{numRows(v.node->getTableIDs()), v.predicateChain != nullptr});
+    }
+    // Pattern edges with table-level statistics and the cached per-vertex degree arrays.
+    std::vector<RPTGEdgeInfo> edgeInfos;
+    std::vector<std::shared_ptr<const std::vector<uint32_t>>> edgeDegrees(2 * pattern.edges.size());
+    for (auto e = 0u; e < pattern.edges.size(); ++e) {
+        auto& edge = pattern.edges[e];
+        RPTGEdgeInfo info;
+        info.a = edge.a;
+        info.b = edge.b;
+        auto relTableIDs = edge.rel->getInnerRelTableIDs();
+        info.numRels = numRows(relTableIDs);
+        info.avgDegA = info.numRels / std::max(vertexInfos[edge.a].numNodes, 1.0);
+        info.avgDegB = info.numRels / std::max(vertexInfos[edge.b].numNodes, 1.0);
+        edgeInfos.push_back(info);
+        if (relTableIDs.size() == 1 && edge.a != edge.b) {
+            // a is the rel's src: its degree along this edge is the FWD adjacency length
+            edgeDegrees[RPTGBudgetModel::slot(e, edge.a, edge.b)] =
+                RPTGDegreeCache::get(context, relTableIDs[0], RelDataDirection::FWD);
+            edgeDegrees[RPTGBudgetModel::slot(e, edge.b, edge.a)] =
+                RPTGDegreeCache::get(context, relTableIDs[0], RelDataDirection::BWD);
+        }
+    }
+
+    // Plan-time pre-screen with zone-map selectivity estimates in place of the (not yet known) exact
+    // sizes: only transfers the budget would plausibly admit are emitted, together with the
+    // self-masks of the vertices they touch. A query with no such transfer gets no side pipeline at
+    // all. Final decisions are still taken at run time with exact sizes.
+    auto config = context->getClientConfig();
+    std::vector<bool> keep(candidates.size(), true);
+    std::vector<double> baseSizes;
+    if (config->rptgMode >= 2 && config->rptgBeta >= 0) {
+        RPTGBudgetModel model;
+        for (auto& t : candidates) {
+            model.infos.push_back(makeInfo(t));
+        }
+        model.planNodes = planNodes;
+        model.vertices = vertexInfos;
+        model.edges = edgeInfos;
+        model.initSideAvgDeg();
+        model.beta = config->rptgBeta;
+        model.pipelineCost = config->rptgPipelineCost;
+        model.transferUnitCost = config->rptgTransferUnitCost;
+        std::vector<double> sizes(pattern.vertices.size());
+        std::vector<bool> known(pattern.vertices.size());
+        for (auto v = 0u; v < pattern.vertices.size(); ++v) {
+            auto& vertex = pattern.vertices[v];
+            known[v] = vertex.predicateChain != nullptr;
+            sizes[v] = vertexInfos[v].numNodes;
+            if (known[v]) {
+                sizes[v] *= estimateChainSelectivity(context, *vertex.node, vertex.predicateChain);
+            }
+        }
+        model.baseSizes = sizes;
+        baseSizes = sizes;
+        auto decisions = model.prescreen(sizes, known,
+            static_cast<uint32_t>(pattern.edges.size()), config->rptgPrescreenSlack);
+        std::vector<bool> admitted(candidates.size(), false);
+        for (auto i = 0u; i < candidates.size(); ++i) {
+            admitted[i] = decisions[i].run;
+        }
+        // Dropping transfers can orphan earlier ones: a kept transfer must still be consumed by a scan
+        // of its target in the main plan or by a later kept transfer reading that target.
+        for (auto i = static_cast<int64_t>(candidates.size()) - 1; i >= 0; --i) {
+            if (!admitted[i] || candidates[i].selfMask) {
+                continue;
+            }
+            bool consumed = !pattern.vertices[candidates[i].y].mainScans.empty();
+            for (auto j = static_cast<uint64_t>(i) + 1; j < candidates.size() && !consumed; ++j) {
+                consumed = admitted[j] && !candidates[j].selfMask && candidates[j].x == candidates[i].y;
+            }
+            admitted[i] = consumed;
+        }
+        std::vector<bool> touched(pattern.vertices.size(), false);
+        for (auto i = 0u; i < candidates.size(); ++i) {
+            if (admitted[i]) {
+                touched[candidates[i].x] = touched[candidates[i].y] = true;
+            }
+        }
+        double netGain = 0;
+        for (auto i = 0u; i < candidates.size(); ++i) {
+            if (candidates[i].selfMask) {
+                netGain -= touched[candidates[i].x] ? model.selfMaskCost : 0.0;
+            } else if (admitted[i]) {
+                netGain += model.beta * decisions[i].gain - decisions[i].cost;
+            }
+        }
+        uint32_t numKept = 0;
+        for (auto i = 0u; i < candidates.size(); ++i) {
+            keep[i] = netGain > 0 && (candidates[i].selfMask ? touched[candidates[i].x] : admitted[i]);
+            numKept += keep[i] && !candidates[i].selfMask;
+        }
+        if (std::getenv("RPTG_DEBUG") != nullptr) {
+            fprintf(stderr, "[rptg] pre-screen (zone-map estimates:");
+            for (auto v = 0u; v < sizes.size(); ++v) {
+                fprintf(stderr, " |B%u|~%.0f", v, sizes[v]);
+            }
+            fprintf(stderr, ") -> %u of %zu transfers kept\n", numKept,
+                static_cast<size_t>(std::count_if(candidates.begin(), candidates.end(),
+                    [](const Planned& t) { return !t.selfMask; })));
+        }
+        if (numKept == 0) {
+            return;
+        }
+    }
+
+    // Build the kept sub-plans. Sources first: their scans consume earlier writes into the vertex.
+    std::vector<Planned> planned;
+    for (auto i = 0u; i < candidates.size(); ++i) {
+        if (keep[i]) {
+            planned.push_back(candidates[i]);
+        }
+    }
+    std::vector<std::shared_ptr<LogicalOperator>> sources(planned.size());
+    for (auto i = 0u; i < planned.size(); ++i) {
+        auto& x = pattern.vertices[planned[i].x];
+        if (x.predicateChain != nullptr) {
+            sources[i] = x.predicateChain->copy();
+        } else {
+            sources[i] = std::make_shared<LogicalScanNodeTable>(x.node->getInternalID(),
+                x.node->getTableIDs(), expression_vector{});
+        }
+        if (!planned[i].selfMask) {
+            x.transferScans.emplace_back(i, findScan(sources[i].get()));
+        }
+    }
+    std::vector<std::shared_ptr<LogicalOperator>> subPlans;
+    std::vector<RPTGTransferInfo> infos;
+    for (auto i = 0u; i < planned.size(); ++i) {
+        auto& t = planned[i];
+        auto& x = pattern.vertices[t.x];
+        auto& y = pattern.vertices[t.y];
+        std::shared_ptr<LogicalOperator> maskerChild = sources[i];
+        if (!t.selfMask) {
+            auto& edge = pattern.edges[t.edgeIdx];
+            bool extendFromSource = edge.rel->getSrcNodeName() == x.node->getUniqueName();
+            auto direction = extendFromSource ? ExtendDirection::FWD : ExtendDirection::BWD;
+            maskerChild = std::make_shared<LogicalExtend>(x.node, y.node, edge.rel, direction,
+                extendFromSource, expression_vector{}, sources[i]);
+        }
+        auto masker = std::make_shared<LogicalSemiMasker>(SemiMaskKeyType::NODE,
+            SemiMaskTargetType::SCAN_NODE, y.node->getInternalID(), y.node->getTableIDs(),
+            maskerChild);
+        masker->setIntersect(true);
+        for (auto scan : y.mainScans) {
+            masker->addTarget(scan);
+        }
+        for (auto& [idx, scan] : y.transferScans) {
+            if (t.selfMask || idx > i) {
+                masker->addTarget(scan);
+            }
+        }
+        if (masker->getTargetOperators().empty()) {
+            continue; // nothing reads this mask
+        }
+        std::shared_ptr<LogicalOperator> sink = std::make_shared<LogicalDummySink>(masker);
+        // Same schema/flatten logic as the main plan.
+        LogicalPlan subPlan;
+        subPlan.setLastOperator(sink);
+        FactorizationRewriter().rewrite(&subPlan);
+        subPlans.push_back(subPlan.getLastOperator());
+        infos.push_back(makeInfo(t));
+    }
+
+    plan->rptgTransfers = std::move(subPlans);
+    plan->rptgInfos = std::move(infos);
+    plan->rptgPlanNodes = std::move(planNodes);
+    plan->rptgNumEdges = static_cast<uint32_t>(pattern.edges.size());
+    plan->rptgVertices = vertexInfos;
+    plan->rptgEdges = edgeInfos;
+    if (baseSizes.empty()) {
+        for (auto v = 0u; v < pattern.vertices.size(); ++v) {
+            baseSizes.push_back(vertexInfos[v].numNodes * (vertexInfos[v].hasPredicate ? 0.1 : 1.0));
+        }
+    }
+    plan->rptgBaseSizes = baseSizes;
+    for (auto& v : pattern.vertices) {
+        for (auto scan : v.mainScans) {
+            plan->rptgMainScans.push_back(scan);
+        }
+    }
+    plan->rptgEdgeDegrees = edgeDegrees;
+    for (auto& v : pattern.vertices) {
+        // a scan whose mask sees every write into this vertex: a main scan, else the last transfer scan
+        const LogicalOperator* scan = nullptr;
+        if (!v.mainScans.empty()) {
+            scan = v.mainScans.front();
+        } else if (!v.transferScans.empty()) {
+            scan = v.transferScans.back().second;
+        }
+        plan->rptgVertexScans.push_back(scan);
+    }
+    if (std::getenv("RPTG_DEBUG") != nullptr) {
+        fprintf(stderr, "[rptg] optimizer emitted %zu sub-plans (pattern: %zu vertices, %zu edges)\n",
+            plan->rptgTransfers.size(), pattern.vertices.size(), pattern.edges.size());
+    }
+}
