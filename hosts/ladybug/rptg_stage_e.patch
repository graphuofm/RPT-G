     bool isProfile() const;
+
+    // RPT-G: transfer sub-plans (each rooted at a LogicalDummySink), in execution order. They run
+    // to completion, one after the other, before any pipeline of the main plan.
+    std::vector<std::shared_ptr<LogicalOperator>> rptgTransfers;
+    // Parallel to rptgTransfers: static budget inputs, and one scan of x / of y whose mask gives the
+    // exact candidate-set size at run time (nullptr if there is none).
+    std::vector<common::RPTGTransferInfo> rptgInfos;
