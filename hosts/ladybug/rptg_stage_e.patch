+    std::vector<const LogicalOperator*> rptgVertexScans;
+    uint32_t rptgNumEdges = 0;
+    std::vector<common::RPTGEdgeInfo> rptgEdges;
+    // Cached per-vertex degree arrays, two per pattern edge (slot order of RPTGBudgetModel::slot);
