diff --git a/src/include/processor/operator/rptg_transfer_sink.h b/src/include/processor/operator/rptg_transfer_sink.h
new file mode 100644
index 0000000..7a8bc73
--- /dev/null
+++ b/src/include/processor/operator/rptg_transfer_sink.h
@@ -0,0 +1,108 @@
+#pragma once
+
+#include <mutex>
+
+#include "common/mask.h"
+#include "common/rptg_transfer_info.h"
+#include "processor/operator/semi_masker.h"
+#include "processor/operator/sink.h"
+
+namespace kuzu {
+namespace processor {
+
+// Run-time side of RPT-G's transfer budget. Transfers run one after the other before the main
+// plan, so when transfer i is about to start every candidate set written so far has an exact size
+// (a mask cardinality). The controller admits T_i iff
+//     cost(T_i) = |B_x| * avgdeg(x -> y)  <=  beta * benefit(T_i),
+// where benefit(T_i) = [work(main plan) + cost(later transfers)] without T_i minus the same with
+// T_i. Both are obtained by simulating the remaining transfers with the closed-form survival
+//     surv(a -> b) = 1 - (1 - |B_a| / |V_a|)^avgdeg(b -> a)
+// (information does not compound over a round trip on the same edge) and evaluating the main
+// plan's operator tree on the resulting sizes. A rejected transfer never writes its target masks.
+class RPTGController {
+public:
+    RPTGController(std::vector<common::RPTGTransferInfo> infos,
+        std::vector<common::RPTGPlanNode> planNodes, std::vector<common::RPTGVertexInfo> vertices,
+        uint32_t numEdges, double beta, double pipelineCost = 0)
+        : infos{std::move(infos)}, planNodes{std::move(planNodes)}, vertices{std::move(vertices)},
+          beta{beta}, pipelineCost{pipelineCost}, maskers(this->infos.size(), nullptr),
+          vertexMask(this->vertices.size(), nullptr), decision(this->infos.size(), -1),
+          sizeBefore(this->infos.size(), 0), edgeFactor(2 * static_cast<size_t>(numEdges), 1.0) {}
+
+    bool shouldRun(uint32_t idx);
+    void finished(uint32_t idx);
+
+    std::vector<common::RPTGTransferInfo> infos;
+    std::vector<common::RPTGPlanNode> planNodes;
+    std::vector<common::RPTGVertexInfo> vertices;
+    double beta;
+    double pipelineCost;
+    std::vector<SemiMaskerSharedState*> maskers;
+    std::vector<common::SemiMask*> vertexMask; // one mask per pattern vertex that sees every write
+
+private:
+    // Exact once a mask was written. Otherwise the whole table; for a predicate vertex whose
+    // self-mask was not run, `optimistic` keeps the table size (upper bound on any gain) and the
+    // default assumes the host's 10% selectivity.
+    double sizeOf(uint32_t v, bool optimistic = false) const {
+        auto mask = vertexMask[v];
+        if (mask != nullptr && mask->isWritten()) {
+            return static_cast<double>(mask->getNumMaskedNodes());
+        }
+        return vertices[v].hasPredicate && !optimistic ? 0.1 * vertices[v].numNodes :
+                                                         vertices[v].numNodes;
+    }
+    bool informative(uint32_t v) const {
+        return vertexMask[v] != nullptr && vertexMask[v]->isWritten();
+    }
+    // masked[v]: the scans of v read only |B_v| rows instead of the whole table.
+    double planWork(const std::vector<double>& sizes, const std::vector<bool>& masked) const;
+    // Rows read by a scan cost this fraction of a tuple flowing through an operator.
+    static constexpr double SCAN_ROW_WEIGHT = 0.15;
+    // Simulates transfers [from, end) on sizes/factors; returns the cost of the simulated transfers
+    // other than `first`.
+    double simulate(uint32_t from, uint32_t first, std::vector<double>& sizes,
+        std::vector<double>& factors, std::vector<bool>& known) const;
+    // factor slot of (edge, target side): side 0 = the edge's first endpoint in infos order
+    static size_t slot(uint32_t edgeIdx, uint32_t target, uint32_t other) {
+        return 2 * static_cast<size_t>(edgeIdx) + (target < other ? 0 : 1);
+    }
+
+    std::mutex mtx;
+    std::vector<int8_t> decision; // -1 undecided, 0 skip, 1 run
+    std::vector<double> sizeBefore;
+    // edgeFactor[slot(e, b, a)] = factor by which B_b was last reduced by a transfer a -> b over e.
+    std::vector<double> edgeFactor;
+};
+
+class RPTGTransferSink final : public Sink {
+    static constexpr PhysicalOperatorType type_ = PhysicalOperatorType::DUMMY_SINK;
+
+public:
+    RPTGTransferSink(std::shared_ptr<RPTGController> controller, uint32_t idx,
+        std::unique_ptr<PhysicalOperator> child, uint32_t id)
+        : Sink{type_, std::move(child), id, OPPrintInfo::EmptyInfo()},
+          controller{std::move(controller)}, idx{idx} {}
+
+    std::unique_ptr<PhysicalOperator> copy() override {
+        auto result = std::make_unique<RPTGTransferSink>(controller, idx, children[0]->copy(), id);
+        result->setDescriptor(resultSetDescriptor->copy());
+        return result;
+    }
+
+protected:
+    void executeInternal(ExecutionContext* context) override {
+        if (!controller->shouldRun(idx)) {
+            return;
+        }
+        while (children[0]->getNextTuple(context)) {}
+    }
+    void finalizeInternal(ExecutionContext* /*context*/) override { controller->finished(idx); }
+
+private:
+    std::shared_ptr<RPTGController> controller;
+    uint32_t idx;
+};
+
+} // namespace processor
+} // namespace kuzu
