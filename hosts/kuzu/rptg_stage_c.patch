new file mode 100644
index 0000000..d205379
--- /dev/null
+++ b/src/include/common/rptg_transfer_info.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace kuzu {
+namespace common {
+
+// Static description of one RPT-G sub-plan, produced by the optimizer and consumed by the run-time
+// controller that decides, when a transfer is about to start, whether its exact cost is justified.
+struct RPTGTransferInfo {
+    // A self-mask pipeline B_x <- sigma_x(V_x): makes |B_x| an exact mask cardinality.
+    bool selfMask = false;
+    uint32_t x = 0, y = 0;
+    uint32_t edgeIdx = 0;
+    // Average number of pattern-edge neighbours of an x-vertex on the y side, and vice versa.
+    double avgDegXtoY = 0, avgDegYtoX = 0;
+};
+
+// The main plan, reduced to what determines its work: scans of pattern vertices, extends and hash
+// joins. Stored in post-order (children before parents). Evaluated at run time with the exact
+// candidate-set sizes, because the host estimates (10% per range predicate in Kuzu) are useless.
+enum class RPTGPlanNodeType : uint8_t { SCAN = 0, EXTEND = 1, HASH_JOIN = 2, PASS = 3, STOP = 4 };
+struct RPTGPlanNode {
+    RPTGPlanNodeType type = RPTGPlanNodeType::PASS;
+    int32_t left = -1, right = -1;
+    uint32_t vertex = 0;  // SCAN: scanned vertex
+    double avgDeg = 1;    // EXTEND: neighbours per bound vertex
+    double numKeys = 0;   // HASH_JOIN: size of the key vertex's table (0 if unknown)
+};
+
+struct RPTGVertexInfo {
+    double numNodes = 0;
+    bool hasPredicate = false;
+};
+
+} // namespace common
+} // namespace kuzu
