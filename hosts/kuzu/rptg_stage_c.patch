+// Tuples flowing through the main plan, from exact leaf sizes: SCAN -> |B_v|, EXTEND -> child * deg,
+// HASH_JOIN -> probe * build / |V_key|.
+double RPTGController::planWork(const std::vector<double>& sizes,
+    const std::vector<bool>& masked) const {
+    std::vector<double> out(planNodes.size(), 0.0);
+    double work = 0;
+    for (auto i = 0u; i < planNodes.size(); ++i) {
+        auto& node = planNodes[i];
+        double l = node.left >= 0 ? out[node.left] : 0.0;
+        double r = node.right >= 0 ? out[node.right] : 0.0;
+        switch (node.type) {
+        case RPTGPlanNodeType::SCAN:
+            out[i] = sizes[node.vertex];
+            work += SCAN_ROW_WEIGHT *
+                    (masked[node.vertex] ? sizes[node.vertex] : vertices[node.vertex].numNodes);
+            break;
+        case RPTGPlanNodeType::EXTEND:
+            out[i] = l * node.avgDeg;
+            break;
+        case RPTGPlanNodeType::HASH_JOIN:
+            out[i] = node.numKeys > 0 ? l * r / node.numKeys : std::max(l, r);
+            break;
+        case RPTGPlanNodeType::STOP:
+            out[i] = 1;
+            break;
+        default:
+            out[i] = l;
+            break;
+        }
+        if (node.type != RPTGPlanNodeType::PASS && node.type != RPTGPlanNodeType::STOP) {
+            work += out[i];
+        }
+    }
+    return work;
+}
+
+double RPTGController::simulate(uint32_t from, uint32_t first, std::vector<double>& sizes,
+    std::vector<double>& factors, std::vector<bool>& known) const {
+    double laterCost = 0;
+    for (auto j = from; j < infos.size(); ++j) {
+        auto& t = infos[j];
+        if (t.selfMask || !known[t.x]) {
+            continue; // a source nobody has informed yet transfers nothing
+        }
+        double src = sizes[t.x];
+        // undo the reduction x received from y over this very edge: no compounding on a round trip
+        src /= std::max(factors[slot(t.edgeIdx, t.x, t.y)], 1e-12);
+        double rho = std::min(1.0, src / std::max(vertices[t.x].numNodes, 1.0));
+        double surv = 1.0 - std::pow(1.0 - rho, t.avgDegYtoX);
+        if (j != first) {
+            laterCost += pipelineCost + sizes[t.x] * t.avgDegXtoY;
+        }
+        sizes[t.y] *= surv;
+        factors[slot(t.edgeIdx, t.y, t.x)] *= surv;
+        known[t.y] = true;
+    }
+    return laterCost;
+}
+
+bool RPTGController::shouldRun(uint32_t idx) {
+    std::lock_guard<std::mutex> lck{mtx};
+    if (decision[idx] >= 0) {
+        return decision[idx] == 1;
+    }
+    auto& info = infos[idx];
+    bool run = true;
+    if (!info.selfMask) {
+        if (!informative(info.x)) {
+            run = false; // run-time source skip: nothing was written into x
+        } else if (beta >= 0) {
+            std::vector<double> sizes(vertices.size());
+            std::vector<bool> known(vertices.size());
+            for (auto v = 0u; v < vertices.size(); ++v) {
+                sizes[v] = sizeOf(v);
+                known[v] = informative(v);
+            }
+            double cost = pipelineCost + sizes[info.x] * info.avgDegXtoY;
+            auto sizesWith = sizes, sizesWithout = sizes;
+            auto factorsWith = edgeFactor, factorsWithout = edgeFactor;
+            auto knownWith = known, knownWithout = known;
+            double laterWith = simulate(idx, idx, sizesWith, factorsWith, knownWith);
+            double laterWithout = simulate(idx + 1, idx, sizesWithout, factorsWithout, knownWithout);
+            double gain = (planWork(sizesWithout, knownWithout) + laterWithout) -
+                          (planWork(sizesWith, knownWith) + laterWith);
+            run = cost <= beta * gain;
+            if (std::getenv("RPTG_DEBUG") != nullptr) {
+                fprintf(stderr,
+                    "[rptg] T%u %u->%u |Bx|=%.0f |By|=%.0f cost=%.0f gain=%.0f (plan work now %.0f) -> %s\n",
+                    idx, info.x, info.y, sizes[info.x], sizes[info.y], cost, gain, planWork(sizes, known),
+                    run ? "RUN" : "SKIP");
+            }
+        }
+        sizeBefore[idx] = sizeOf(info.y);
+    } else {
+        // A self-mask is a pipeline too: once the main plan's work, bounded from above with the sizes
+        // known so far, is below the fixed cost of one pipeline, nothing that follows can pay off.
+        if (beta >= 0) {
+            std::vector<double> sizes(vertices.size());
+            std::vector<bool> known(vertices.size());
+            for (auto v = 0u; v < vertices.size(); ++v) {
+                sizes[v] = sizeOf(v, true /* optimistic */);
+                known[v] = informative(v);
+            }
+            double upper = planWork(sizes, known);
+            run = beta * upper >= pipelineCost;
+            if (std::getenv("RPTG_DEBUG") != nullptr) {
+                fprintf(stderr, "[rptg] T%u self-mask of vertex %u: plan work <= %.0f -> %s\n", idx, info.x,
+                    upper, run ? "RUN" : "SKIP");
+            }
+        }
+    }
+    decision[idx] = run ? 1 : 0;
+    if (!run && maskers[idx] != nullptr) {
+        maskers[idx]->setSkipped();
+    }
+    return run;
+}
+
+void RPTGController::finished(uint32_t idx) {
+    std::lock_guard<std::mutex> lck{mtx};
+    auto& info = infos[idx];
+    if (decision[idx] == 1 && !info.selfMask && sizeBefore[idx] > 0) {
+        edgeFactor[slot(info.edgeIdx, info.y, info.x)] *= sizeOf(info.y) / sizeBefore[idx];
+    }
+}
+
+} // namespace processor
+} // namespace kuzu
