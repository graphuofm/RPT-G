@@ -0,0 +1,37 @@
+#pragma once
+
+#include "planner/operator/logical_plan.h"
+
+namespace kuzu {
+namespace main {
+class ClientContext;
+}
+namespace planner {
+class CardinalityEstimator;
+}
+namespace optimizer {
+
+// RPT-G: robust predicate transfer for graph pattern queries.
+//
+// Recovers the (tree-shaped) pattern from the logical plan, builds the transfer sequence of
+// Algorithm 1' (forward pass leaves -> root, backward pass root -> leaves), prunes transfers whose
+// information is never consumed, and materializes every remaining transfer x -> y as a side
+// pipeline
+//     SCAN_NODE_TABLE(x) [FILTER sigma_x] -> EXTEND(x -> y) -> SEMI_MASKER(y, intersect) -> DUMMY_SINK
+// whose masks land on the SCAN_NODE_TABLE(y) operators of the main plan and of later transfers.
+// Unlike the accumulate-based hash-join SIP, the main plan is not materialized anywhere.
+class RPTGTransferOptimizer {
+public:
+    RPTGTransferOptimizer(main::ClientContext* context,
+        const planner::CardinalityEstimator& cardinalityEstimator)
+        : context{context}, cardinalityEstimator{cardinalityEstimator} {}
+
+    void rewrite(planner::LogicalPlan* plan);
+
+private:
+    main::ClientContext* context;
+    const planner::CardinalityEstimator& cardinalityEstimator;
+};
+
+} // namespace optimizer
+} // namespace kuzu
