diff --git a/src/include/processor/operator/rptg_transfer_sink.h b/src/include/processor/operator/rptg_transfer_sink.h
new file mode 100644
index 0000000..6e3c803
--- /dev/null
+++ b/src/include/processor/operator/rptg_transfer_sink.h
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <mutex>
+
+#include "common/mask.h"
+#include "common/rptg_transfer_info.h"
+#include "processor/operator/semi_masker.h"
+#include "processor/operator/sink.h"
+
+namespace kuzu {
+namespace processor {
+
+// Run-time side of RPT-G's transfer budget. Transfers run one after the other before the main
+// plan, so when transfer i is about to start the candidate sets are known exactly (mask
+// cardinalities); the controller admits it only if
+//     cost = |B_x| * avgdeg(x -> y)  <=  beta * benefit,
+//     benefit = (1 - surv) * |B_y| * workPerTuple(y)   (or the best benefit of a later transfer it feeds),
+//     surv = 1 - (1 - |B_x| / |V_x|)^avgdeg(y -> x).
+// A rejected transfer never writes its target masks.
+class RPTGController {
+public:
+    RPTGController(std::vector<common::RPTGTransferInfo> infos, double beta)
+        : infos{std::move(infos)}, beta{beta}, sourceMask(this->infos.size(), nullptr),
+          targetMask(this->infos.size(), nullptr), maskers(this->infos.size(), nullptr),
+          decision(this->infos.size(), -1), sizeBefore(this->infos.size(), 0),
+          sizeAfter(this->infos.size(), 0) {}
+
+    bool shouldRun(uint32_t idx);
+    void finished(uint32_t idx);
+
+    std::vector<common::RPTGTransferInfo> infos;
+    double beta;
+    std::vector<common::SemiMask*> sourceMask, targetMask;
+    std::vector<SemiMaskerSharedState*> maskers;
+
+private:
+    static double size(const common::SemiMask* mask, double numNodes) {
+        return mask != nullptr && mask->isWritten() ? static_cast<double>(mask->getNumMaskedNodes()) :
+                                                      numNodes;
+    }
+    double benefit(uint32_t idx, double bx, double by, int32_t cameFrom, double byBeforeCameFrom,
+        uint32_t depth) const;
+
+    std::mutex mtx;
+    std::vector<int8_t> decision; // -1 undecided, 0 skip, 1 run
+    std::vector<double> sizeBefore, sizeAfter;
+};
+
+class RPTGTransferSink final : public Sink {
+    static constexpr PhysicalOperatorType type_ = PhysicalOperatorType::DUMMY_SINK;
+
+public:
+    RPTGTransferSink(std::shared_ptr<RPTGController> controller, uint32_t idx,
+        std::unique_ptr<PhysicalOperator> child, uint32_t id)
+        : Sink{type_, std::move(child), id, OPPrintInfo::EmptyInfo()},
+          controller{std::move(controller)}, idx{idx} {}
+
+    std::unique_ptr<PhysicalOperator> copy() override {
+        auto result = std::make_unique<RPTGTransferSink>(controller, idx, children[0]->copy(), id);
+        result->setDescriptor(resultSetDescriptor->copy());
+        return result;
+    }
+
+protected:
+    void executeInternal(ExecutionContext* context) override {
+        if (!controller->shouldRun(idx)) {
+            return;
+        }
+        while (children[0]->getNextTuple(context)) {}
+    }
+    void finalizeInternal(ExecutionContext* /*context*/) override { controller->finished(idx); }
+
+private:
+    std::shared_ptr<RPTGController> controller;
+    uint32_t idx;
+};
+
+} // namespace processor
+} // namespace kuzu
