+#include "processor/operator/rptg_transfer_sink.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace kuzu {
+namespace processor {
+
+// Estimated benefit of running transfer idx with source size bx and target size by. cameFrom is
+// the transfer whose (estimated) effect produced bx when we recurse into a later transfer;
+// byBeforeCameFrom is the size its target had before it, used to undo same-edge round trips.
+double RPTGController::benefit(uint32_t idx, double bx, double by, int32_t cameFrom,
+    double byBeforeCameFrom, uint32_t depth) const {
+    auto& info = infos[idx];
+    double src = bx;
+    if (info.sameEdgeReverse >= 0) {
+        auto rev = static_cast<uint32_t>(info.sameEdgeReverse);
+        if (static_cast<int32_t>(rev) == cameFrom) {
+            src = byBeforeCameFrom; // x was just (hypothetically) reduced by y over this very edge
+        } else if (decision[rev] == 1 && sizeAfter[rev] > 0) {
+            src = bx * sizeBefore[rev] / sizeAfter[rev];
+        }
+    }
+    double rho = std::min(1.0, src / std::max(info.numNodesX, 1.0));
+    double surv = 1.0 - std::pow(1.0 - rho, info.avgDegYtoX);
+    double best = (1.0 - surv) * by * info.workPerTupleY;
+    if (depth < 8) {
+        double byAfter = by * surv;
+        for (auto j : info.laterFromY) {
+            auto& next = infos[j];
+            double nextTarget = size(targetMask[j], next.numNodesY);
+            best = std::max(best,
+                benefit(j, byAfter, nextTarget, static_cast<int32_t>(idx), by, depth + 1));
+        }
+    }
+    return best;
+}
+
+bool RPTGController::shouldRun(uint32_t idx) {
+    std::lock_guard<std::mutex> lck{mtx};
+    if (decision[idx] >= 0) {
+        return decision[idx] == 1;
+    }
+    auto& info = infos[idx];
+    bool run = true;
+    if (!info.selfMask) {
+        bool sourceInformative =
+            info.sourceHasPredicate || (sourceMask[idx] != nullptr && sourceMask[idx]->isWritten());
+        double bx = size(sourceMask[idx], info.numNodesX);
+        double by = size(targetMask[idx], info.numNodesY);
+        if (!sourceInformative) {
+            run = false; // run-time source skip: an earlier transfer into x was rejected
+        } else if (beta >= 0) {
+            double cost = bx * info.avgDegXtoY;
+            run = cost <= beta * benefit(idx, bx, by, -1, 0, 0);
+        }
+        sizeBefore[idx] = by;
+    }
+    decision[idx] = run ? 1 : 0;
+    if (!run && maskers[idx] != nullptr) {
+        maskers[idx]->setSkipped();
+    }
+    return run;
+}
+
+void RPTGController::finished(uint32_t idx) {
+    std::lock_guard<std::mutex> lck{mtx};
+    if (decision[idx] == 1 && !infos[idx].selfMask) {
+        sizeAfter[idx] = size(targetMask[idx], infos[idx].numNodesY);
+    }
+}
+
