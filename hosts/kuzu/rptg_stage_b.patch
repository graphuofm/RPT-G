@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace kuzu {
+namespace common {
+
+// Static description of one RPT-G transfer x -> y, produced by the optimizer and consumed by the
+// run-time controller that decides, when the transfer is about to start, whether its exact cost is
+// justified by the estimated benefit.
+struct RPTGTransferInfo {
+    // A self-mask pipeline B_x <- sigma_x(V_x): always runs, makes |B_x| exact for later decisions.
+    bool selfMask = false;
+    uint32_t x = 0, y = 0;
+    bool sourceHasPredicate = false;
+    double numNodesX = 0, numNodesY = 0;
+    // Average number of pattern-edge neighbours of an x-vertex on the y side, and vice versa.
+    double avgDegXtoY = 0, avgDegYtoX = 0;
+    // Host-estimated main-plan work per tuple leaving the consumer scan(s) of y; 0 if the main plan
+    // does not scan y (the transfer is then only consumed by later transfers).
+    double workPerTupleY = 0;
+    // Earlier transfer y -> x over the same pattern edge (-1 if none): information does not compound
+    // over a round trip.
+    int32_t sameEdgeReverse = -1;
+    // Later kept transfers that read y.
+    std::vector<uint32_t> laterFromY;
+};
+
+} // namespace common
+} // namespace kuzu
